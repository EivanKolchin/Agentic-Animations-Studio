# Copy to .env and fill in. .env is gitignored and must stay that way.

# Google AI Studio key (aistudio.google.com/apikey).
# This is NOT your Gemini Pro subscription login - it is a separate
# API key, billed separately, and it is what the studio calls.
GEMINI_API_KEY=

# Hard ceiling on image generations per production run. The CLI
# refuses to exceed it without an explicit override flag.
STUDIO_CREDIT_CAP=40

# Where finished sprites are delivered, relative to studio/.
# Project-specific: this is the only path the engine needs to know.
STUDIO_DELIVER_TO=../site/assets

# The ENGINE repository's git directory, for `node run.mjs engine <git args>`
# and `npm run hygiene --publish`.
#
# Two repositories share this working tree: the host project's, which
# tracks everything including the art, and the engine's, which publishes
# the system alone. The engine's git directory lives OUTSIDE the tree -
# a .git inside studio/ would make the host record a gitlink instead of
# files - and it excludes bible/, canon/ and productions/ through its own
# info/exclude rather than through a .gitignore both repos would read.
#
#   git --git-dir=/path/to/engine.git init --bare
#   git --git-dir=/path/to/engine.git config core.bare false
#   git --git-dir=/path/to/engine.git config core.worktree /path/to/studio
STUDIO_ENGINE_GIT=

# ffmpeg, for the video step. Optional: without it the frame stack is
# still written and the export says so. Leave blank to use PATH.
STUDIO_FFMPEG=
